# Optional RES Studio settings (never commit real secrets)
# HTTP engine: auto (default), requests, or curl
RES_HTTP_ENGINE=auto

# Require an API key if clients beyond localhost must access the local API.
# RES_API_KEY=replace-with-a-long-random-secret

# Optional isolated Chromium (requires the separate Docker worker).
RES_ENABLE_ISOLATED_CHROMIUM=0
