FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir 'playwright>=1.48,<2' \
    && python -m playwright install --with-deps chromium \
    && useradd --create-home --uid 10001 resstudio \
    && mkdir -p /home/resstudio/.cache \
    && cp -a /root/.cache/ms-playwright /opt/ms-playwright \
    && chmod -R a+rX /opt/ms-playwright
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
COPY chromium_worker.py /app/chromium_worker.py
USER 10001:10001
CMD ["python","/app/chromium_worker.py"]
